+/// Preferred side of an element-anchored tooltip.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TooltipPlacement {
+    /// Above the trigger.
+    Top,
+    /// Above the trigger, aligned to its left edge.
+    TopStart,
+    /// Above the trigger, aligned to its right edge.
+    TopEnd,
+    /// Below the trigger.
+    Bottom,
+    /// Below the trigger, aligned to its left edge.
+    BottomStart,
+    /// Below the trigger, aligned to its right edge.
+    BottomEnd,
+    /// Before the trigger horizontally.
+    Left,
+    /// After the trigger horizontally.
+    Right,
+}
+
+/// Element bounds and spacing used to position a tooltip independently of the pointer.
+#[derive(Clone, Copy, Debug)]
+pub struct TooltipAnchor {
+    /// The trigger bounds in viewport coordinates.
+    pub bounds: Bounds<Pixels>,
+    /// The preferred side.
+    pub placement: TooltipPlacement,
+    /// The distance from the trigger.
+    pub offset: Pixels,
+}
+
+impl TooltipAnchor {
+    /// Position and round the origin to the nearest physical pixel, with positive
+    /// half pixels rounded upward. Keep the measured content size unchanged.
+    pub fn tooltip_bounds_at_scale(
+        self,
+        size: Size<Pixels>,
+        viewport: Size<Pixels>,
+        margin: Pixels,
+        scale_factor: f32,
+    ) -> Bounds<Pixels> {
+        let mut bounds = self.tooltip_bounds(size, viewport, margin);
+        bounds.origin = bounds
+            .origin
+            .map(|value| Pixels((value.0 * scale_factor).round() / scale_factor));
+        bounds
+    }
+
+    /// Prefer the requested side, flip when it cannot fit, then clamp to the viewport.
+    pub fn tooltip_bounds(
+        self,
+        size: Size<Pixels>,
+        viewport: Size<Pixels>,
+        margin: Pixels,
+    ) -> Bounds<Pixels> {
+        let center = self.bounds.center();
+        let top = point(
+            center.x - size.width / 2.,
+            self.bounds.top() - size.height - self.offset,
+        );
+        let bottom = point(
+            center.x - size.width / 2.,
+            self.bounds.bottom() + self.offset,
+        );
+        let left = point(
+            self.bounds.left() - size.width - self.offset,
+            center.y - size.height / 2.,
+        );
+        let right = point(
+            self.bounds.right() + self.offset,
+            center.y - size.height / 2.,
+        );
+        let (preferred, alternate) = match self.placement {
+            TooltipPlacement::Top => (top, bottom),
+            TooltipPlacement::Bottom => (bottom, top),
+            TooltipPlacement::TopStart => (point(self.bounds.left(), top.y), point(self.bounds.left(), bottom.y)),
+            TooltipPlacement::TopEnd => (point(self.bounds.right() - size.width, top.y), point(self.bounds.right() - size.width, bottom.y)),
+            TooltipPlacement::BottomStart => (point(self.bounds.left(), bottom.y), point(self.bounds.left(), top.y)),
+            TooltipPlacement::BottomEnd => (point(self.bounds.right() - size.width, bottom.y), point(self.bounds.right() - size.width, top.y)),
+            TooltipPlacement::Left => (left, right),
+            TooltipPlacement::Right => (right, left),
+        };
+        // Cross-axis overflow is handled by clamping, not by flipping the side.
+        let main_fits = |origin: Point<Pixels>| match self.placement {
+            TooltipPlacement::Top | TooltipPlacement::Bottom |
+            TooltipPlacement::TopStart | TooltipPlacement::TopEnd |
+            TooltipPlacement::BottomStart | TooltipPlacement::BottomEnd => {
+                origin.y >= margin && origin.y + size.height <= viewport.height - margin
+            }
+            TooltipPlacement::Left | TooltipPlacement::Right => {
+                origin.x >= margin && origin.x + size.width <= viewport.width - margin
+            }
+        };
+        let origin = if main_fits(preferred) || !main_fits(alternate) {
+            preferred
+        } else {
+            alternate
+        };
+        Bounds::new(
+            point(
+                origin
+                    .x
+                    .max(margin)
+                    .min((viewport.width - size.width - margin).max(margin)),
+                origin
+                    .y
+                    .max(margin)
+                    .min((viewport.height - size.height - margin).max(margin)),
+            ),
+            size,
+        )
+    }
+}
