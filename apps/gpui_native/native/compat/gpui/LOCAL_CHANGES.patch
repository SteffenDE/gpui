+
+    #[test]
+    fn edge_alignment_survives_flipping_and_clamps_at_the_viewport_margin() {
+        let viewport = size(px(400.), px(200.));
+        let content = size(px(180.), px(28.));
+        for (placement, expected_x) in [(TooltipPlacement::TopStart, 100.), (TooltipPlacement::TopEnd, 40.)] {
+            let anchor = TooltipAnchor { bounds: Bounds::new(point(px(100.), px(5.)), size(px(120.), px(22.))), placement, offset: px(6.) };
+            assert_eq!(anchor.tooltip_bounds(content, viewport, px(5.)).origin, point(px(expected_x), px(33.)));
+        }
+        for placement in [TooltipPlacement::TopStart, TooltipPlacement::BottomStart] {
+            let anchor = TooltipAnchor { bounds: Bounds::new(point(px(350.), px(150.)), size(px(40.), px(22.))), placement, offset: px(6.) };
+            assert_eq!(anchor.tooltip_bounds(content, viewport, px(5.)).origin, point(px(215.), px(116.)));
+        }
+    }
+
+    #[test]
+    fn anchored_origin_rounds_after_fitting_without_resizing_content() {
+        let anchor = TooltipAnchor {
+            bounds: Bounds::new(point(px(1320.), px(5.5)), size(px(24.), px(24.))),
+            placement: TooltipPlacement::Top,
+            offset: px(4.),
+        };
+        let tooltip = size(px(144.375), px(28.));
+        let viewport = size(px(1400.), px(900.));
+        let at_one = anchor.tooltip_bounds_at_scale(tooltip, viewport, px(5.), 1.);
+        assert_eq!(at_one.origin, point(px(1251.), px(34.)));
+        assert_eq!(at_one.size, tooltip);
+        let at_two = anchor.tooltip_bounds_at_scale(tooltip, viewport, px(5.), 2.);
+        assert_eq!(at_two.origin, point(px(1250.5), px(33.5)));
+        assert_eq!(at_two.size, tooltip);
+        // A configured margin changes both the collision decision and clamping.
+        let near_top = TooltipAnchor {
+            bounds: Bounds::new(point(px(0.), px(36.)), size(px(24.), px(24.))),
+            ..anchor
+        };
+        assert_eq!(
+            near_top
+                .tooltip_bounds_at_scale(tooltip, viewport, px(4.), 1.)
+                .origin,
+            point(px(4.), px(4.))
+        );
+        assert_eq!(
+            near_top
+                .tooltip_bounds_at_scale(tooltip, viewport, px(5.), 1.)
+                .origin,
+            point(px(5.), px(64.))
+        );
+    }
